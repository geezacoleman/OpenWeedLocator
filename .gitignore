# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/

# OWL Setup: Sensitive files
*.key
*.crt
.htpasswd-*

# OWL configuration (created by setup.sh, contains site-specific settings)
config/CONTROLLER.ini

# Per-unit mount geometry (device-resident; created on first use of the geometry
# editor). See config/GEOMETRY_TEMPLATE.ini for a documented reference.
config/GEOMETRY.ini

# User-saved config presets (created from dashboard Save As)
config/config_*

# Active-config pointer (device state written by the dashboard; readers fall
# back to config/GENERAL_CONFIG.ini when it's absent, so a fresh clone needs
# no copy of it)
config/active_config.txt

# Painted LUT detection profiles (device/site-specific, created by the weed
# painter on OWLs and in the controller library)
config/lut_profiles/
uploads/lut_profiles/

# OWL collected images (created during detection/recording)
owl_data/

# OWL non-template log files
owl.jsonl

# Agent runtime data (directory structure kept, contents ignored)
agent/widgets/*/
agent/sessions/

# Custom algorithms (user-generated via agent)
custom_algorithms/

# model files unless explicitly excluded
/models/*.pt
/models/*.zip

# Internal design docs (not for public repo)
claude_docs/
.claude/
PROJECT_NOTES.md
CLAUDE.md
tmpclaude-*
/PLAN.md
/agent_sessions/
/docs/
/examples/
/config/DESKTOP_TEST.ini
/benchmarks/results/
.idea
/tests/e2e/screenshots/

