# OWL first-boot setup service — template
# Installed by install_firstboot.sh, which substitutes __OWL_DIR__ and __VENV__.
# Only runs while the first-boot flag exists; /setup/api/finish removes the
# flag and the service never starts again (until re-armed).

[Unit]
Description=OWL First-Boot Setup Service
ConditionPathExists=/boot/firmware/owl-firstboot.flag
After=NetworkManager.service network-online.target
Wants=network-online.target

[Service]
Type=simple
# Root: nmcli hotspot control, ufw, avahi service file, flag removal
User=root
WorkingDirectory=__OWL_DIR__/controller/setup
ExecStart=__VENV__/bin/python __OWL_DIR__/controller/setup/setup_app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
